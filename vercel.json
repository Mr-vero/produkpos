{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run ingest && node scripts/check-db.mjs",
  "functions": {
    "api/index.js": {
      "includeFiles": "{data,pos,node_modules/@fastify/swagger-ui/static}/**",
      "maxDuration": 10
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
